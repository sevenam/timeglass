<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment. Docs are required only where we say so, not on every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>sevenam</Company>
    <Product>Timeglass</Product>
    <!--
      Versions come from git tags (#38): v0.1.0 gives 0.1.0, and commits after it 0.1.1-alpha.0.N.
      Needs the tags and history, so release jobs check out with fetch-depth: 0.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Before the first tag builds are 0.1.0-alpha.0.N, not 0.0.0-…: the installer (#40) needs a version of at least 0.0.1. -->
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- The release exe (#38) carries its symbols, so stack traces in the log keep line numbers. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
