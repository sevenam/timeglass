          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppTotalDto"
            },
            "description": "Active time per app, or categories including away time; longest first."
          }
        },
        "description": "Totals per day and per app over a range of local days."
      },
      "SettingsDto": {
        "required": [
          "idleThresholdSeconds",
          "idleExemptApps",
          "excludedApps",
          "recordWindowTitles",
          "appsWithoutTitles",
          "appAliases",
          "startWithWindows"
        ],
        "type": "object",
        "properties": {
          "idleThresholdSeconds": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Seconds without keyboard or mouse input before the user counts as away, 30 to 14400; null turns idle detection off.",
            "format": "int32"
          },
          "idleExemptApps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "App keys that never go idle while in front, such as video players."
          },
          "excludedApps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "App keys that are not tracked at all."
          },
          "recordWindowTitles": {
            "type": "boolean",
            "description": "Whether window titles are stored."
          },
          "appsWithoutTitles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "App keys whose time is tracked but whose window titles are never stored."
          },
          "appAliases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppAliasDto"
            },
            "description": "The user's app renames and aliases, applied on top of the built-in ones."
          },
          "startWithWindows": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Whether the app starts when the user signs in; null where the host can't tell (read) or to leave it as it is (write)."
          },
          "workHoursStartMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Minutes after local midnight that work hours begin, 0 to 1439; null keeps the current value (write).",
            "format": "int32"
          },
          "workHoursEndMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Minutes after local midnight that work hours end, after the start and at most 1439; null keeps the current value (write).",
            "format": "int32"
          },
          "categories": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            },
            "description": "Ordered categories of keywords, or null to leave them unchanged."
          },
          "discardAfterHoursReturns": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Whether to exclude qualifying after-hours returns; null keeps the current value (write)."
          },
          "afterHoursMinimumAwayMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Minimum preceding away time in minutes; null keeps the current value (write).",
            "format": "int32"
          },
          "afterHoursMaximumReturnMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Maximum final return time in minutes; null keeps the current value (write).",
            "format": "int32"
          }
        },
        "description": "The settings the dashboard can change; the rest of `settings.json` is kept as it is."
      },
