{
  "openapi": "3.1.1",
  "info": {
    "title": "Timeglass",
    "description": "Local API of the Timeglass activity tracker. All durations are in milliseconds.",
    "version": "v1"
  },
  "paths": {
    "/api/days/{date}/summary": {
      "get": {
        "tags": [
          "Days"
        ],
        "summary": "Where the time went on one day",
        "description": "Active and away totals, first and last activity, and active time per app.",
        "operationId": "GetDaySummary",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Local date, yyyy-MM-dd.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DaySummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/days/{date}/timeline": {
      "get": {
        "tags": [
          "Days"
        ],
        "summary": "What happened when on one day",
        "description": "Active and away blocks in time order. Intervals of one app less than 5 seconds apart are merged.",
        "operationId": "GetTimeline",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Local date, yyyy-MM-dd.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "byCategory",
            "in": "query",
            "description": "Include the matching category on each active block.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/days/{date}/apps/{appKey}": {
      "get": {
        "tags": [
          "Days"
        ],
        "summary": "One app's time on one day, by window title",
        "description": "Every title, longest first.",
        "operationId": "GetAppDay",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Local date, yyyy-MM-dd.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "appKey",
            "in": "path",
            "description": "The app's key, e.g. outlook.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppDayDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/range/summary": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "Totals per day and per app over a range of days",
        "description": "For the week view. A range is at most 366 days.",
        "operationId": "GetRangeSummary",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RangeSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/range/categories": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "Totals per category over a range of days",
        "description": "Includes tracked away time as a built-in category. Category shares are of active plus away time.",
        "operationId": "GetCategoryRangeSummary",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RangeSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/range/category-applications": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "Applications contributing to one category over a range of days",
        "operationId": "GetCategoryApplications",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Name of the category, or Ungrouped.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RangeSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/range/category-application-titles": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "Titles contributing to one application's time in a category",
        "operationId": "GetCategoryApplicationTitles",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Name of the category, or Ungrouped.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "appKey",
            "in": "query",
            "description": "The application's key.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryAppTitlesDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "What the tracker is doing right now",
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "The settings the dashboard can change",
        "operationId": "GetSettings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Changes the settings",
        "description": "Validated with the same rules as settings.json; nothing is saved if any value is invalid. Settings the dashboard doesn't edit are kept.",
        "operationId": "PutSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/pause": {
      "post": {
        "tags": [
          "Status"
        ],
        "summary": "Pauses tracking",
        "description": "Pausing while paused changes when the pause ends.",
        "operationId": "Pause",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/resume": {
      "post": {
        "tags": [
          "Status"
        ],
        "summary": "Resumes tracking",
        "operationId": "Resume",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/intervals": {
      "delete": {
        "tags": [
          "Data"
        ],
        "summary": "Deletes the recorded time of a range of days",
        "description": "Everything recorded on the days from and to (included) is deleted for good. The body must confirm the range as from..to.",
        "operationId": "DeleteIntervals",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteIntervalsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "tags": [
          "Data"
        ],
        "summary": "The recorded time of a range of days, as a JSON or CSV file",
        "description": "One row per interval, or per day and app (daily-apps). The answer is written as it is read, so a range can be any length. Time in apps that are excluded now is left out, and so are the titles the privacy settings hide now. In CSV, text that a spreadsheet would run as a formula gets a leading apostrophe.",
        "operationId": "Export",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First local date, yyyy-MM-dd. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last local date, yyyy-MM-dd, included. Required.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "json (the default) or csv.",
            "schema": {
              "enum": [
                "json",
                "csv"
              ],
              "type": "string"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "description": "intervals (the default) or daily-apps.",
            "schema": {
              "enum": [
                "intervals",
                "daily-apps"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDto"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityKind": {
        "enum": [
          "active",
          "away"
        ],
        "description": "Active or away."
      },
      "AppAliasDto": {
        "required": [
          "key",
          "name",
          "exes",
          "titlePattern"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Lowercase app key. An existing key renames that app; a new one adds an app."
          },
          "name": {
            "type": "string",
            "description": "Display name. Empty keeps the existing name when renaming."
          },
          "exes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Executable file names, e.g. olk.exe."
          },
          "titlePattern": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional regular expression the window title must match; null for any title."
          }
        },
        "description": "An app rename or alias: which executables (and window titles) make up an app, and its name."
      },
      "AppDayDto": {
        "required": [
          "date",
          "app",
          "start",
          "end",
          "totalMs",
          "titles",
          "color"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The local date.",
            "format": "date"
          },
          "app": {
            "description": "The app. If it had no time that day, its name is its key.",
            "$ref": "#/components/schemas/AppDto"
          },
          "start": {
            "type": "string",
            "description": "First instant of the day (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "First instant of the next day (exclusive).",
            "format": "date-time"
          },
          "totalMs": {
            "type": "integer",
            "description": "Active time in the app, in milliseconds.",
            "format": "int64"
          },
          "titles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TitleTotalDto"
            },
            "description": "Every title, longest first."
          },
          "color": {
            "type": [
              "null",
              "string"
            ],
            "description": "Persistent display colour, or null if the app has no recorded time."
          }
        },
        "description": "Where the time in one app went on one local day, by window title."
      },
      "AppDto": {
        "required": [
          "key",
          "name"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable key, used in URLs, e.g. `outlook`."
          },
          "name": {
            "type": "string",
            "description": "Display name, e.g. `Outlook`."
          }
        },
        "description": "An app as shown to the user."
      },
      "AppTotalDto": {
        "required": [
          "app",
          "durationMs",
          "share",
          "percent",
          "color"
        ],
        "type": "object",
        "properties": {
          "app": {
            "description": "The app or category.",
            "$ref": "#/components/schemas/AppDto"
          },
          "durationMs": {
            "type": "integer",
            "description": "Time in the app or category, in milliseconds.",
            "format": "int64"
          },
          "share": {
            "type": "number",
            "description": "Exact fraction of active time, or active plus away for categories, between 0 and 1.",
            "format": "double"
          },
          "percent": {
            "type": "integer",
            "description": "Whole percentage; the percentages of one list add up to 100.",
            "format": "int32"
          },
          "color": {
            "type": "string",
            "description": "Persistent display colour for the app."
          }
        },
        "description": "One app's or category's share of the time."
      },
      "CategoryAppTitlesDto": {
        "required": [
          "app",
          "totalMs",
          "titles"
        ],
        "type": "object",
        "properties": {
          "app": {
            "description": "The application.",
            "$ref": "#/components/schemas/AppDto"
          },
          "totalMs": {
            "type": "integer",
            "description": "Active time assigned to the category, in milliseconds.",
            "format": "int64"
          },
          "titles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TitleTotalDto"
            },
            "description": "Titles and time without an available title, longest first."
          }
        },
        "description": "One application's titles assigned to a category over a range."
      },
      "CategoryDto": {
        "required": [
          "name",
          "keywords"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Category name."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Case-insensitive substrings to match."
          }
        },
        "description": "A named category of keywords, matched in the order categories are listed."
      },
      "DaySummaryDto": {
        "required": [
          "date",
          "start",
          "end",
          "activeMs",
          "awayMs",
          "firstActivity",
          "lastActivity",
          "workdayMs",
          "apps"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The local date.",
            "format": "date"
          },
          "start": {
            "type": "string",
            "description": "First instant of the day (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "First instant of the next day (exclusive); 23 or 25 hours after the start on DST days.",
            "format": "date-time"
          },
          "activeMs": {
            "type": "integer",
            "description": "Total active time, in milliseconds.",
            "format": "int64"
          },
          "awayMs": {
            "type": "integer",
            "description": "Total away time (idle, locked or asleep), in milliseconds.",
            "format": "int64"
          },
          "firstActivity": {
            "type": [
              "null",
              "string"
            ],
            "description": "Start of the first active time, or null if there was none.",
            "format": "date-time"
          },
          "lastActivity": {
            "type": [
              "null",
              "string"
            ],
            "description": "End of the last active time, or null if there was none.",
            "format": "date-time"
          },
          "workdayMs": {
            "type": "integer",
            "description": "Time from the first to the last activity that falls inside the work hours in the settings (09:00 to 17:00 by default), in milliseconds.",
            "format": "int64"
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppTotalDto"
            },
            "description": "Active time per app, longest first."
          }
        },
        "description": "Where the time went on one local day."
      },
      "DayTotalDto": {
        "required": [
          "date",
          "start",
          "end",
          "activeMs",
          "awayMs",
          "apps"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The local date.",
            "format": "date"
          },
          "start": {
            "type": "string",
            "description": "First instant of the day (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "First instant of the next day (exclusive).",
            "format": "date-time"
          },
          "activeMs": {
            "type": "integer",
            "description": "Active time, in milliseconds.",
            "format": "int64"
          },
          "awayMs": {
            "type": "integer",
            "description": "Away time, in milliseconds.",
            "format": "int64"
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppTotalDto"
            },
            "description": "Every app used that day, or categories including away time; longest first."
          }
        },
        "description": "One day in a range."
      },
      "DeleteIntervalsRequest": {
        "required": [
          "confirm"
        ],
        "type": "object",
        "properties": {
          "confirm": {
            "type": [
              "null",
              "string"
            ],
            "description": "The range being deleted, written as `from..to` (e.g. `2026-11-02..2026-11-04`), so a request can't delete a range it didn't mean to."
          }
        },
        "description": "Confirms a deletion."
      },
      "ExportDailyAppDto": {
        "required": [
          "date",
          "app",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The local date.",
            "format": "date"
          },
          "app": {
            "description": "The app.",
            "$ref": "#/components/schemas/AppDto"
          },
          "durationMs": {
            "type": "integer",
            "description": "Active time in the app that day, in milliseconds.",
            "format": "int64"
          }
        },
        "description": "One app's active time on one local day."
      },
      "ExportDto": {
        "required": [
          "from",
          "to",
          "granularity",
          "intervals",
          "dailyApps"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "First local date.",
            "format": "date"
          },
          "to": {
            "type": "string",
            "description": "Last local date (included).",
            "format": "date"
          },
          "granularity": {
            "description": "Which of the lists is filled.",
            "$ref": "#/components/schemas/ExportGranularity"
          },
          "intervals": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ExportIntervalDto"
            },
            "description": "The intervals in time order, clipped to the range; null for daily-apps."
          },
          "dailyApps": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ExportDailyAppDto"
            },
            "description": "Active time per day and app, in date order and the most time first within a day; null for intervals."
          }
        },
        "description": "The recorded time of a range of days, as a JSON export. One of the two lists is filled, by granularity."
      },
      "ExportGranularity": {
        "enum": [
          "intervals",
          "daily-apps"
        ],
        "description": "What one row of an export is."
      },
      "ExportIntervalDto": {
        "required": [
          "kind",
          "app",
          "title",
          "start",
          "end",
          "durationMs",
          "isOpen"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "description": "Active or away.",
            "$ref": "#/components/schemas/ActivityKind"
          },
          "app": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The app of active time; null for away time.",
                "$ref": "#/components/schemas/AppDto"
              }
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "The window title; null if none was recorded or the privacy settings hide it."
          },
          "start": {
            "type": "string",
            "description": "Start (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "End (exclusive); the time of the export if the interval is still running.",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "description": "End minus start, in milliseconds.",
            "format": "int64"
          },
          "isOpen": {
            "type": "boolean",
            "description": "True if the interval is still running."
          }
        },
        "description": "One recorded interval."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PauseDuration": {
        "enum": [
          "untilResumed",
          "thirtyMinutes",
          "oneHour",
          "untilTomorrow"
        ],
        "description": "How long to pause tracking for; the same choices as the tray menu."
      },
      "PauseRequest": {
        "required": [
          "duration"
        ],
        "type": "object",
        "properties": {
          "duration": {
            "description": "How long to pause for.",
            "$ref": "#/components/schemas/PauseDuration"
          }
        },
        "description": "A request to pause tracking."
      },
      "RangeSummaryDto": {
        "required": [
          "from",
          "to",
          "start",
          "end",
          "activeMs",
          "awayMs",
          "days",
          "apps"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "First local date.",
            "format": "date"
          },
          "to": {
            "type": "string",
            "description": "Last local date (included).",
            "format": "date"
          },
          "start": {
            "type": "string",
            "description": "First instant of the first day (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "First instant of the day after the last (exclusive).",
            "format": "date-time"
          },
          "activeMs": {
            "type": "integer",
            "description": "Total active time, in milliseconds.",
            "format": "int64"
          },
          "awayMs": {
            "type": "integer",
            "description": "Total away time, in milliseconds.",
            "format": "int64"
          },
          "days": {
            "type": "array",
