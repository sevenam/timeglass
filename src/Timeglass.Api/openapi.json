          "state": {
            "description": "What the tracker is doing.",
            "$ref": "#/components/schemas/TrackingStateKind"
          },
          "pausedUntil": {
            "type": [
              "null",
              "string"
            ],
            "description": "When a pause ends by itself; null if it doesn't, or if not paused.",
