          "today": {
            "type": "string",
            "description": "Today's local date.",
            "format": "date"
          },
          "now": {
            "type": "string",
            "description": "The server's current time, to count the running stretch from.",
            "format": "date-time"
          }
        },
        "description": "The tracker's current state."
      },
      "TimelineBlockDto": {
        "required": [
          "kind",
          "app",
          "start",
          "end",
          "durationMs",
          "isOpen",
          "category"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "description": "Active or away.",
            "$ref": "#/components/schemas/ActivityKind"
          },
          "app": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The app of an active block; null for an away block.",
                "$ref": "#/components/schemas/AppDto"
              }
            ]
          },
          "start": {
            "type": "string",
            "description": "Start (inclusive).",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "End (exclusive).",
            "format": "date-time"
          },
          "durationMs": {
            "type": "integer",
            "description": "Time tracked in the block, in milliseconds: end minus start, less the short gaps merged over.",
            "format": "int64"
          },
          "isOpen": {
            "type": "boolean",
            "description": "True if the block is still running."
          },
          "category": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Category for category timelines, otherwise null.",
                "$ref": "#/components/schemas/AppDto"
              }
            ]
          }
        },
        "description": "A stretch of time in one app, or away; intervals a few seconds apart are merged."
      },
      "TimelineDto": {
        "required": [
          "date",
          "start",
          "end",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The local date.",
            "format": "date"
          },
          "start": {
            "type": "string",
            "description": "First instant of the day (inclusive).",
            "format": "date-time"
          },
          "end": {
