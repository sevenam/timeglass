<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Timeglass.App</RootNamespace>
    <AssemblyName>Timeglass</AssemblyName>
    <ApplicationIcon>Assets\timeglass.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    The release build (#38) is a self-contained, single-file win-x64 publish (the package job in ci.yml).
    Native libraries (SQLite) go inside the exe and are extracted on first run, so the zip holds
    Timeglass.exe alone.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timeglass.Core\Timeglass.Core.csproj" />
    <ProjectReference Include="..\Timeglass.Storage\Timeglass.Storage.csproj" />
    <ProjectReference Include="..\Timeglass.Api\Timeglass.Api.csproj" />
    <ProjectReference Include="..\Timeglass.Windows\Timeglass.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic host: DI, configuration, logging and lifetime. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- ValidateDataAnnotations for the user's settings (#22). -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- Rolling log files behind Microsoft.Extensions.Logging (#21). -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Serves the embedded dashboard (#30). -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <!-- Installer and auto-update (#40). -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons: normal and paused. -->
    <EmbeddedResource Include="Assets/*.ico" LogicalName="Timeglass.App.Assets.%(Filename)%(Extension)" ExcludeFromManifest="true" />
  </ItemGroup>

  <!-- Builds web/ and embeds web/dist (#30). -->
  <Import Project="Dashboard.targets" />

  <ItemGroup>
    <InternalsVisibleTo Include="Timeglass.App.Tests" />
  </ItemGroup>

</Project>
